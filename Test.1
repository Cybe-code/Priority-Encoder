`timescale 1ns/100ps

module test_priority();
  reg [7:0]W;
  wire [2:0]Y;
  wire z;
  priority dut(.W(W),.Y(Y),.z(z));
  initial begin
    W=8'b00000000;
    #100;
    W=8'b00000001;
    #100;
    W=8'b00000010;
    #100;
    W=8'b00000100;
    #100;
    W=8'b00001000;
    #100;
    W=8'b00010000;
    #100;
    W=8'b00100000;
    #100;
    W=8'b01000000;
    #100;
    W=8'b10000000;
    #100;
    $stop();
  end
endmodule