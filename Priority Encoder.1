module priority (W ,Y, z);
    input [7:0]W;
    output reg [2:0]Y;
    output reg z;

    always @(W) begin
       z = 1;
       casex (W)
           8'b1xxxxxxx: Y = 7;
           8'b01xxxxxx: Y = 6;
           8'b001xxxxx: Y = 5;
           8'b0001xxxx: Y = 4;
           8'b00001xxx: Y = 3;
           8'b000001xx: Y = 2;
           8'b0000001x: Y = 1;
           8'b00000001: Y = 0;
           default: begin
              z = 0;
              Y = 3'bx;
            end
        endcase
    end
endmodule